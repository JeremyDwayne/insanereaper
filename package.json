    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.169.7",
    "arktype": "^2.2.10",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
